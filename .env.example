# Host ports
MAIN_SITE_PORT=8080
BOOKING_SITE_PORT=3000
BOOKING_APP_ORIGIN=http://localhost:3000

# Local Compose database credentials. Replace all passwords outside local development.
# Use a long URL-safe password (letters, numbers, underscores, and hyphens); Compose
# embeds this value in DATABASE_URL as well as passing it directly to MySQL.
RIDGEBACK_DB_NAME=ridgebackrv
RIDGEBACK_DB_USER=ridgeback
RIDGEBACK_DB_PASSWORD=ridgeback_local_password
RIDGEBACK_DB_ROOT_PASSWORD=ridgeback_local_root_password
