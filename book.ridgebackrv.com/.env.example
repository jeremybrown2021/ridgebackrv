# The Compose stack overrides DATABASE_URL, PORT, and APP_ORIGIN.
DATABASE_URL=mysql://ridgeback:ridgeback_local_password@database:3306/ridgebackrv
DB_CONNECTION_LIMIT=5
PORT=3000
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# Keep payments disabled until valid Clover sandbox values are configured.
PAYMENTS_ENABLED=false
CLOVER_ENVIRONMENT=sandbox
CLOVER_MERCHANT_ID=
CLOVER_PUBLIC_TOKEN=
CLOVER_PRIVATE_TOKEN=
CLOVER_QUOTE_SECRET=
CLOVER_WEBHOOK_AUTH_CODE=

# Local development can return reset links directly.
AUTH_SESSION_HOURS=12
AUTH_REMEMBER_DAYS=30
AUTH_RESET_MINUTES=30
AUTH_EXPOSE_RESET_LINKS=true

# Required when AUTH_EXPOSE_RESET_LINKS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
AUTH_FROM_EMAIL="Ridgeback RV <no-reply@ridgebackrv.com>"
